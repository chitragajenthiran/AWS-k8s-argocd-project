# ===========================================
# ARGO CD REPOSITORY SECRET
# ===========================================
# Template for adding private repository access

apiVersion: v1
kind: Secret
metadata:
  name: gitops-demo-repo
  namespace: argocd
  labels:
    argocd.argoproj.io/secret-type: repository
stringData:
  type: git
  url: https://github.com/YOUR_ORG/gitops-demo.git
  # For GitHub App authentication (recommended)
  # githubAppID: "123456"
  # githubAppInstallationID: "12345678"
  # githubAppPrivateKey: |
  #   -----BEGIN RSA PRIVATE KEY-----
  #   ...
  #   -----END RSA PRIVATE KEY-----
  
  # For token authentication
  # username: git
  # password: ghp_YOUR_TOKEN_HERE
  
  # For SSH authentication
  # sshPrivateKey: |
  #   -----BEGIN OPENSSH PRIVATE KEY-----
  #   ...
  #   -----END OPENSSH PRIVATE KEY-----
